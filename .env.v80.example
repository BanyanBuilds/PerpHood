# Add these in Vercel Project Settings > Environment Variables.
# Mark secret values Sensitive. Never prefix secrets with NEXT_PUBLIC_.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
LEVERAGEX_OWNER=0xYOUR_SECURE_OWNER_OR_MULTISIG_ADDRESS
LEVERAGEX_DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_THROWAWAY_DEPLOYER_PRIVATE_KEY
LEVERAGEX_DEPLOY_ADMIN_TOKEN=GENERATE_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Add these after the deployment endpoint returns them, then redeploy:
LEVERAGEX_LIQUIDITY_LOCKER_ADDRESS=
LEVERAGEX_LAUNCH_FACTORY_ADDRESS=
