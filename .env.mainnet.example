# Leverage X V60 — LOCAL MAINNET PREFLIGHT / CLOSED DEPLOYMENT / CANARY CONTROL
# Copy this file to .env.mainnet.local. That local file is gitignored.
# Never paste private keys, Alchemy URLs, or keystore passwords into chat.

# Private Alchemy Robinhood Chain Mainnet HTTPS endpoint.
ROBINHOOD_MAINNET_RPC_URL=

# Public project accounts confirmed for the first controlled deployment.
V59_EXPECTED_DEPLOYER_ADDRESS=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V59_FACTORY_OWNER=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V59_FIRST_TRADER_ADDRESS=0x1728DC75f70070DC74Ae2172EF94970e04D9830C

# Preferred signing mode: encrypted Foundry keystore.
# Create once with: cast wallet import leveragex-deployer --interactive
V59_KEYSTORE_ACCOUNT=leveragex-deployer
# Optional absolute path outside this project. Required for the automated npm deploy command.
V59_KEYSTORE_PASSWORD_FILE=

# Fallback only: local plaintext key. Never commit or add this to Vercel/Supabase.
V59_DEPLOYER_PRIVATE_KEY=

# Keep blank until the exact deliberate deployment run.
V59_MAINNET_DEPLOY_CONFIRM=

# Populated after deployment; the final public values are written to deployments/v59-vercel-public.env.
LEVERAGEX_FACTORY_ADDRESS=
V59_MAINNET_FACTORY_ADDRESS=

# V60 — one-creator / one-market canary controls.
V60_CANARY_CREATOR_ADDRESS=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V60_CANARY_MARKET_ADDRESS=
# Deliberate owner actions. Leave blank except during the exact command being run.
# CONFIGURE_LEVERAGE_X_MAINNET_CANARY_ALLOWLIST
V60_CANARY_CONFIGURE_CONFIRM=
# OPEN_FIRST_LEVERAGE_X_MAINNET_SPOT_CANARY
V60_CANARY_OPEN_CONFIRM=
# EMERGENCY_LOCKDOWN_LEVERAGE_X_MAINNET
V60_EMERGENCY_PAUSE_CONFIRM=

# Public Vercel values are generated after each successful local owner action.
NEXT_PUBLIC_LEVERAGEX_CANARY_CREATOR_ADDRESS=
NEXT_PUBLIC_LEVERAGEX_RELEASE_STAGE=factory-preflight
NEXT_PUBLIC_LEVERAGEX_MAINNET_ENABLED=false
