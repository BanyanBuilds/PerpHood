# Leverage X V66 — focused local-only mainnet operator template
# Copy this file to .env.mainnet.local. Never commit the copied file.

# Private Robinhood Chain mainnet HTTPS RPC.
ROBINHOOD_MAINNET_RPC_URL=

# Expected deployment/operator identities. These are public addresses, not secrets.
V65_EXPECTED_DEPLOYER_ADDRESS=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V65_FACTORY_OWNER=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V65_CANARY_CREATOR_ADDRESS=0x728fa84C70f7b88Ab59C86379745FdDBbDd7AD07
V65_FIRST_TRADER_ADDRESS=0x1728DC75f70070DC74Ae2172EF94970e04D9830C

# Preferred signer: import a local encrypted Foundry keystore.
# Example: cast wallet import leveragex-deployer --interactive
V65_KEYSTORE_ACCOUNT=leveragex-deployer
V65_KEYSTORE_PASSWORD_FILE=
# Emergency local fallback only. Never commit, upload, paste into chat, Vercel, or Supabase.
V65_DEPLOYER_PRIVATE_KEY=

# Deployment remains locked unless the exact confirmation is deliberately added.
V65_MAINNET_DEPLOY_CONFIRM=

# One-creator canary configuration. This cap applies to msg.value/creator buy, not gas.
V65_CANARY_MAX_INITIAL_BUY_WEI=10000000000000000
V65_CANARY_CONFIGURE_CONFIRM=

# First real token metadata.
V65_FIRST_TOKEN_NAME=
V65_FIRST_TOKEN_SYMBOL=
V65_FIRST_TOKEN_METADATA_URI=
V65_FIRST_TOKEN_METADATA_HASH=

# TOTAL launch budget ceiling inclusive of the live maximum gas reserve.
# 1,000,000,000,000,000 wei = 0.001 ETH total.
V65_FIRST_TOKEN_TOTAL_BUDGET_WEI=1000000000000000
V65_FIRST_TOKEN_LAUNCH_CONFIRM=

# Independent-wallet Spot roundtrip proof.
V65_TRADER_KEYSTORE_ACCOUNT=
V65_TRADER_KEYSTORE_PASSWORD_FILE=
V65_TRADER_PRIVATE_KEY=
V65_TRADER_BUY_WEI=100000000000000
V65_TRADER_SELL_BPS=5000
V65_TRADER_ROUNDTRIP_CONFIRM=

# Filled automatically after deployment/launch or copied from generated evidence files.
LEVERAGEX_V65_FACTORY_ADDRESS=
LEVERAGEX_V65_LIQUIDITY_LOCKER_ADDRESS=
V65_FIRST_TOKEN_ADDRESS=
V65_FIRST_POOL_ADDRESS=

# Optional graduation and GMGN evidence gates.
V65_GRADUATE_CONFIRM=
V65_GMGN_BACKFILL_CONFIRM=

# Keep every confirmation blank until the preceding read-only gate passes.

# Legacy V64 evidence scripts retained for reproducibility; V66 deployment uses V65_* values above.
V64_CREATOR_KEYSTORE_ACCOUNT=
V64_CREATOR_KEYSTORE_PASSWORD_FILE=
V64_CREATOR_PRIVATE_KEY=
V64_TRADER_KEYSTORE_ACCOUNT=
V64_TRADER_KEYSTORE_PASSWORD_FILE=
V64_TRADER_PRIVATE_KEY=
