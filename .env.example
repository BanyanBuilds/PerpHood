# Optional production-shaped persistence. The local application shell runs without these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values for future indexed chain data and owner reporting.
SUPABASE_SERVICE_ROLE_KEY=
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_CHAIN_WS_URL=
PERPHOOD_TREASURY_ADDRESS=

# Required for live-only charts. No demo candles are generated when these are absent.
# WebSocket trade payload: { "market": "token-slug", "price": 0.001, "size": 1200, "timestamp": 1784810000000, "side": "buy" }
NEXT_PUBLIC_MARKET_WS_URL=
# GET ?market=<slug>&interval=1s&limit=3000 -> { "candles": [{ "time": 1784810000, "open": 1, "high": 1, "low": 1, "close": 1, "volume": 0 }] }
NEXT_PUBLIC_MARKET_HISTORY_URL=

# V23 local-chain custody + full-action session execution mode. Use only with Anvil/local EVM test funds.
# Set to "chain" to show the contract frame as the custody authority in the terminal.
NEXT_PUBLIC_BATTLE_SOURCE=chain
NEXT_PUBLIC_LOCAL_CHAIN_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_LOCAL_BATTLE_POOL_ADDRESS=
NEXT_PUBLIC_LOCAL_CHAIN_POLL_MS=120
NEXT_PUBLIC_LOCAL_MARKET_SLUG=hood

# Server-side local sponsored relay. Anvil account 0 is used when omitted.
LOCAL_CHAIN_RPC=http://127.0.0.1:8545
V23_SEQUENCER_ACCOUNT=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# Optional local keeper protection for /api/v23/liquidate.
V23_KEEPER_SECRET=

# V24 separate fixed-point contract verifier. Deploy with scripts/devnet/deploy-v24.bat.
NEXT_PUBLIC_V24_BATTLE_POOL_ADDRESS=
V24_SEQUENCER_ACCOUNT=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

# V33 native X Launch Feed. Server-only; never expose the bearer token to the browser.
# Uses the official X recent-search endpoint for the built-in prototype feed.
X_BEARER_TOKEN=
# Optional default query. Users may override it inside the X Launch Feed panel.
X_LAUNCH_DEFAULT_QUERY=launch OR launching OR memecoin OR "contract address"
# Optional true real-time filtered-stream worker. Run with: npm run x:stream
PERPHOOD_X_INGEST_URL=http://localhost:3000/api/x-launch-feed/ingest
X_STREAM_INGEST_SECRET=
# JSON array of X filtered-stream rules. Keep within the access tier's rule limits.
X_STREAM_RULES=[{"value":"(launch OR launching OR memecoin OR \"contract address\") -is:retweet","tag":"perphood-launch-radar"}]

# V41 local launchpad test controls
NEXT_PUBLIC_LAUNCHPAD_TEST_MODE=true
NEXT_PUBLIC_LAUNCHPAD_MIGRATION_TARGET_USD=45000
NEXT_PUBLIC_LAUNCHPAD_ETH_USD_REFERENCE=3200
# Production integration placeholders — leave unset for local test mode.
ROBINHOOD_CHAIN_RPC_URL=
LAUNCHPAD_FACTORY_ADDRESS=
LAUNCHPAD_MIGRATION_COORDINATOR_ADDRESS=

# V42 executable local launchpad sandbox (Anvil chain 31337 only).
# Run `npm run chain:anvil` in one terminal and `npm run chain:v42` in another.
# The deploy command prints the factory address and writes public/local-chain/v42-deployment.json.
NEXT_PUBLIC_V42_LAUNCHPAD_FACTORY_ADDRESS=
V42_LAUNCHPAD_FACTORY_ADDRESS=

# V43 unified local BattlePool sandbox (Anvil chain 31337 only).
# Run `npm run chain:anvil` in one terminal and `npm run chain:v43` in another.
# The deploy command prints the factory address and writes public/local-chain/v43-deployment.json.
NEXT_PUBLIC_V43_LAUNCHPAD_FACTORY_ADDRESS=
V43_LAUNCHPAD_FACTORY_ADDRESS=

# V45 authorized account execution (Anvil chain 31337 only).
# Run `npm run chain:anvil` and then `npm run chain:v45`.
# The V45 factory is also the custody/account router in this local reference architecture.
NEXT_PUBLIC_V45_LAUNCHPAD_FACTORY_ADDRESS=
NEXT_PUBLIC_V45_ACCOUNT_ROUTER_ADDRESS=
V45_LAUNCHPAD_FACTORY_ADDRESS=
V45_ACCOUNT_ROUTER_ADDRESS=
V45_SEQUENCER_ACCOUNT=

# V46 durable order and keeper network (local development).
# Leave autorun disabled when using the standalone keeper worker.
NEXT_PUBLIC_V46_LOCAL_KEEPER_AUTORUN=false
PERPHOOD_APP_URL=http://localhost:3000
V46_KEEPER_SECRET=
# Comma-separated local keeper/sequencer accounts. Falls back to V45_SEQUENCER_ACCOUNT.
V46_KEEPER_ACCOUNTS=
V46_KEEPER_INTERVAL_MS=1500
# Legacy V46 JSON path used only for the one-time idempotent import into V47 SQLite.
V46_ORDER_STORE_PATH=.perphood/v46-orders.json

# V47 authoritative indexer, SQL order store, reconciliation, and recovery.
# Node 22+ is required for the built-in node:sqlite reference implementation.
V47_DATABASE_PATH=.perphood/v47-indexer.sqlite
V47_START_BLOCK=0
# Local Anvil defaults to 0; production chains should use a conservative finalized depth.
V47_FINALITY_CONFIRMATIONS=0
V47_INDEX_BATCH_SIZE=250
V47_MAX_REORG_DEPTH=128
V47_INDEXER_INTERVAL_MS=1500
V47_RECONCILIATION_INTERVAL_MS=15000
V47_RECONCILIATION_LIMIT=1000
V47_CHAIN_ID=31337
# Protect write/worker endpoints in any shared environment.
V47_INDEXER_SECRET=
V47_RECONCILER_SECRET=
V47_RECOVERY_SECRET=

# PERPHOOD V48 live data plane
# local | testnet | mainnet. Production defaults to mainnet; development defaults to local.
V48_CHAIN_ENV=local
# Comma-separated independent providers. Use at least 3 production providers when possible.
V48_RPC_URLS=http://127.0.0.1:8545
V48_RPC_QUORUM=1
V48_RPC_TIMEOUT_MS=4000
V48_FINALITY_CONFIRMATIONS=0
V48_INDEXER_BATCH_SIZE=250
V48_DATA_PLANE_INTERVAL_MS=1500
V48_MAX_INDEX_LAG_BLOCKS=4
V48_DATA_PLANE_SECRET=
NEXT_PUBLIC_V48_STREAM_ENABLED=true
# Robinhood Chain mainnet canonical WETH defaults to the official contract when V48_CHAIN_ENV=mainnet.
V48_CANONICAL_WETH_ADDRESS=
# Optional finalized read-model replication. Keep the service-role key server-only.
V48_SUPABASE_URL=
V48_SUPABASE_SERVICE_ROLE_KEY=
V48_REPLICATION_SECRET=
V48_REPLICATION_BATCH_SIZE=1000
V48_REPLICATION_INTERVAL_MS=30000
V48_REPLICATE_AFTER_CYCLE=false
V48_BACKUP_SECRET=

# PERPHOOD V52 scale-foundation placeholders.
# These are interfaces for future production services; leave them empty in local/Vercel preview builds.
V52_RUNTIME_MODE=local
V52_DATABASE_URL=
V52_DATABASE_DIRECT_URL=
V52_CACHE_URL=
V52_EVENT_BUS_URL=
V52_STREAM_INTERNAL_URL=
V52_SERVICE_AUTH_SECRET=
V52_MARKET_EXECUTION_SHARDS=64
V52_ACCOUNT_HISTORY_SHARDS=32
V52_QUEUE_PARTITIONS=64

# PERPHOOD V53 cross-device user-state synchronization.
# Run supabase/v53_user_state.sql before enabling. The service-role key is server-only;
# never prefix it with NEXT_PUBLIC_ and never expose it in browser code.
# Reuses NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the top of this file.
# The synced recovery key can restore settings only; it cannot authorize trades or move funds.
V53_USER_STATE_ENABLED=true

# PERPHOOD V54 — real Robinhood Chain token launch
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_V54_TESTNET_FACTORY_ADDRESS=
NEXT_PUBLIC_V54_MAINNET_FACTORY_ADDRESS=
NEXT_PUBLIC_V54_MAINNET_ENABLED=false

# Server/deployment only. Never prefix these with NEXT_PUBLIC and never commit real values.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
V54_DEPLOYER_PRIVATE_KEY=
V54_FACTORY_OWNER=
V54_VERIFY_CONTRACT=false
V54_ALLOW_MAINNET_DEPLOY=false
