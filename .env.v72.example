# Robinhood Chain mainnet public RPC. A private Alchemy/QuickNode endpoint may replace it.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Owner wallet for the launch factory and canary controls.
LEVERAGEX_OWNER=0xYOUR_OWNER_WALLET

# Never commit or send this value in chat. Set it only in the local PowerShell process used to deploy.
DEPLOYER_PRIVATE_KEY=0xYOUR_THROWAWAY_DEPLOYER_PRIVATE_KEY
